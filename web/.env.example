# Vite will expose only variables prefixed with VITE_ to the frontend.

# Dev proxy target (used by vite.config.js server.proxy)
VITE_API_URL=http://127.0.0.1:5050

# Frontend API prefix (used by src/api/http.js). Default: /api
VITE_API_BASE_PATH=/api

# App display name (used for document.title and UI branding)
VITE_APP_TITLE=可萌

# Build metadata (optional; can also be injected by CI)
# VITE_APP_VERSION=1.0.0
# VITE_BUILD_SHA=abcdef1234567890
# VITE_BUILD_TIME=2026-01-25T00:00:00Z

# Enable build sourcemap for staging debugging (do not enable in production by default)
VITE_SOURCEMAP=false

