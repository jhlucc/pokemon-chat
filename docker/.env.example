# Docker Compose environment (copy to docker/.env and fill as needed)

# ---- Feature flags ----
enable_knowledge_base=false
# Graph is imported automatically on startup (neo4j-bootstrap), so it's convenient to enable by default.
enable_knowledge_graph=true
enable_web_search=false
enable_mcp=false
enable_reranker=false
enable_ner_bert=false
enable_asr=false

# ---- LLM ----
llm_api_key=
llm_api_base=https://api.siliconflow.cn/v1
llm_model_name=Qwen/Qwen2.5-7B-Instruct
llm_temperature=0.7
llm_max_tokens=4096

# Optional provider keys (legacy auto-detection)
SILICONFLOW_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ZHIPUAI_API_KEY=
TAVILY_API_KEY=

# ---- Web search ----
tavily_api_key=

# ---- Tool keys ----
tool_openweather_api_key=

# ---- CORS ----
cors_allow_origins=*
cors_allow_credentials=false

# ---- Databases (docker defaults; override if you changed docker-compose.yml) ----
neo4j_username=neo4j
neo4j_password=

mysql_user=root
mysql_password=123456
mysql_database=langgraph

# Optional images
# MYSQL_IMAGE=mysql:5.7
