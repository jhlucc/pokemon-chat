# Example environment file (copy to `.env` at repo root).
# This single `.env` is used by:
# - local dev (python/uvicorn)
# - Docker Compose (`docker/docker-compose.yml` loads `../.env`)
# - frontend dev/build (Vite loads repo root `.env`)

# -----------------------
# Frontend (Vite)
# -----------------------
# Vite will expose only variables prefixed with VITE_ to the browser.

# Dev proxy target (used by web/vite.config.js server.proxy)
VITE_API_URL=http://127.0.0.1:5050

# Frontend API prefix (used by web/src/api/http.js). Default: /api
VITE_API_BASE_PATH=/api

# App display name (used for document.title and UI branding)
VITE_APP_TITLE=可萌

# Build metadata (optional; can also be injected by CI)
VITE_APP_VERSION=
VITE_BUILD_SHA=
VITE_BUILD_TIME=

# Enable build sourcemap for staging debugging (do not enable in production by default)
VITE_SOURCEMAP=false

# ---- Logging ----
LOG_LEVEL=DEBUG

# ---- Feature flags ----
enable_knowledge_base=false
enable_knowledge_graph=false
enable_web_search=false
enable_mcp=false
enable_reranker=false
enable_ner_bert=false
enable_asr=false

# Safety: allow potentially dangerous graph queries (GraphCypherQAChain)
allow_dangerous_graph_requests=false

# ---- LLM ----
llm_api_key=
llm_api_base=https://api.siliconflow.cn/v1
llm_model_name=Qwen/Qwen2.5-7B-Instruct
llm_temperature=0.7
llm_max_tokens=4096

# Optional provider keys (legacy auto-detection / UI convenience)
SILICONFLOW_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ZHIPUAI_API_KEY=
TAVILY_API_KEY=

# ---- CORS ----
cors_allow_origins=*
cors_allow_credentials=false

# ---- Embedding ----
embedding_provider=siliconflow
embedding_api_key=
embedding_api_base=https://api.siliconflow.cn/v1/embeddings
embedding_model_name=BAAI/bge-m3
embedding_dimension=1024

# ---- Reranker ----
reranker_enabled=true
reranker_api_key=
reranker_api_base=https://api.siliconflow.cn/v1
reranker_model_name=BAAI/bge-reranker-v2-m3
reranker_top_k=10
reranker_threshold=0.1

# ---- Databases ----
# Local defaults (Docker Compose overrides host/port internally)
neo4j_uri=bolt://localhost:7687
neo4j_username=neo4j
neo4j_password=

mysql_host=127.0.0.1
mysql_port=3307
mysql_user=root
mysql_password=123456
mysql_database=langgraph

milvus_uri=http://localhost:19530

# ---- Web search ----
tavily_api_key=

# ---- MCP (optional) ----
mcp_sse_url=http://127.0.0.1:8000/sse
mcp_llm_api_key=
mcp_llm_base_url=
mcp_llm_model=

# ---- ASR (FunASR) ----
funasr_url=ws://localhost:10095

# ---- Agent advanced ----
# Checkpointer type: memory, sqlite
checkpointer_type=memory
# Conversation max messages (short-term memory window)
conversation_max_messages=50
# Time-travel debug
enable_time_travel=false
# Interrupts / approvals
enable_interrupts=false

# ---- Tool keys ----
tool_openweather_api_key=

# ---- LightRAG (optional) ----
lightrag_working_dir=./resources/lightrag_data
lightrag_graph_storage=Neo4JStorage
lightrag_vector_storage=MilvusVectorDBStorage

# ---- App build metadata (backend) ----
# `/readyz` will show these when present (useful for CI/CD)
APP_VERSION=
BUILD_SHA=
BUILD_TIME=
