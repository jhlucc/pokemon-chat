# Example environment file (copy to `.env`).
# For the full list of supported variables, see `.env.template`.

# ---- Logging ----
LOG_LEVEL=DEBUG

# ---- LLM ----
llm_api_key=
llm_api_base=https://api.siliconflow.cn/v1
llm_model_name=Qwen/Qwen2.5-7B-Instruct
llm_temperature=0.7
llm_max_tokens=4096

# Optional provider keys (legacy auto-detection / UI convenience)
SILICONFLOW_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ZHIPUAI_API_KEY=
TAVILY_API_KEY=

# ---- CORS ----
cors_allow_origins=*
cors_allow_credentials=true

# ---- Embedding ----
embedding_provider=siliconflow
embedding_api_key=
embedding_api_base=https://api.siliconflow.cn/v1/embeddings
embedding_model_name=BAAI/bge-m3
embedding_dimension=1024

# ---- Reranker ----
reranker_enabled=true
reranker_api_key=
reranker_api_base=https://api.siliconflow.cn/v1
reranker_model_name=BAAI/bge-reranker-v2-m3
reranker_top_k=10
reranker_threshold=0.1

# ---- Databases ----
neo4j_uri=bolt://localhost:7687
neo4j_username=neo4j
neo4j_password=

mysql_host=127.0.0.1
mysql_port=3307
mysql_user=root
mysql_password=
mysql_database=langgraph

milvus_uri=http://localhost:19530

# ---- Feature flags ----
enable_knowledge_base=false
enable_knowledge_graph=false
enable_web_search=false
enable_mcp=false
enable_reranker=false
enable_ner_bert=false
enable_asr=false

# ---- Web search ----
tavily_api_key=

# ---- MCP / ASR ----
mcp_sse_url=http://127.0.0.1:8000/sse
funasr_url=ws://localhost:10095

# ---- Tool keys ----
tool_openweather_api_key=

