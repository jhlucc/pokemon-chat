# Normalize text file line endings across platforms.
# Keep the repo consistent (LF) while allowing Windows-specific scripts to use CRLF.

* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.7z binary
*.onnx binary
*.pt binary
*.pth binary
*.bin binary
*.safetensors binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
