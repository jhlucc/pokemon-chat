# =============================================
# Pokemon-Chat 环境变量配置
# 使用 Pydantic v2 Settings 自动加载
# =============================================

# ----- Logging -----
# Python logging level: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=DEBUG

# ----- LLM 配置 -----
# 大语言模型配置（统一接口）
llm_api_key=
llm_api_base=https://api.siliconflow.cn/v1
llm_model_name=Qwen/Qwen2.5-7B-Instruct
llm_temperature=0.7
llm_max_tokens=4096

# ----- Provider Keys (optional, compatibility) -----
# Some parts of the project (model picker / legacy config) look for these keys.
# If you only set llm_api_key above, the backend can still run, but provider auto-detection may show as "disabled".
SILICONFLOW_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ZHIPUAI_API_KEY=
TAVILY_API_KEY=

# ----- CORS -----
# Comma-separated list, or "*" to allow all origins (credentials will be disabled when "*").
cors_allow_origins=*
cors_allow_credentials=false

# ----- Embedding 配置 -----
# 向量模型配置（统一接口）
# provider: siliconflow, openai, ollama, dashscope
embedding_provider=siliconflow
embedding_api_key=
embedding_api_base=https://api.siliconflow.cn/v1/embeddings
embedding_model_name=BAAI/bge-m3
embedding_dimension=1024

# ----- Reranker 配置 -----
# 重排序模型配置（统一接口）
reranker_enabled=true
reranker_api_key=
reranker_api_base=https://api.siliconflow.cn/v1
reranker_model_name=BAAI/bge-reranker-v2-m3
reranker_top_k=10
reranker_threshold=0.1

# ----- Neo4j 图数据库 -----
neo4j_uri=bolt://localhost:7687
neo4j_username=neo4j
neo4j_password=

# ----- MySQL 数据库 -----
mysql_host=127.0.0.1
# docker-compose.yml maps host 3307 -> container 3306 by default
mysql_port=3307
mysql_user=root
mysql_password=
mysql_database=langgraph

# ----- Milvus 向量数据库 -----
milvus_uri=http://localhost:19530

# ----- 功能开关 -----
enable_knowledge_base=false
enable_knowledge_graph=false
enable_web_search=false
enable_mcp=false
# Reranker feature flag (independent from reranker_* model config below)
enable_reranker=false
# NER BERT 模型开关 (关闭后不需要安装 torch/transformers)
enable_ner_bert=false
# 语音识别（FunASR）
enable_asr=false
funasr_url=ws://localhost:10095

# Safety: allow potentially dangerous graph queries (GraphCypherQAChain)
allow_dangerous_graph_requests=false

# ----- MCP (optional) -----
# MCP server SSE endpoint (default: http://127.0.0.1:8000/sse)
mcp_sse_url=http://127.0.0.1:8000/sse
# Optional: use a dedicated LLM for MCP tool-calling (falls back to llm_* above if empty)
mcp_llm_api_key=
mcp_llm_base_url=
mcp_llm_model=

# ----- Agent 高级功能 -----
# Checkpointer 类型: memory, sqlite
checkpointer_type=memory
# 对话最大消息数（用于短期记忆管理）
conversation_max_messages=50
# 时间旅行功能
enable_time_travel=false
# 中断/审批功能
enable_interrupts=false

# ----- 网络搜索 -----
# Tavily 搜索 API Key
tavily_api_key=

# ----- 工具配置 -----
# OpenWeather API Key (tool_openweather_api_key or OPENWEATHER_API_KEY)
tool_openweather_api_key=

# ----- LightRAG 配置 -----
# LightRAG 工作目录
lightrag_working_dir=./resources/lightrag_data
# 图存储类型: Neo4JStorage, NetworkXStorage
lightrag_graph_storage=Neo4JStorage
# 向量存储类型: MilvusVectorDBStorage, ChromaVectorDBStorage
lightrag_vector_storage=MilvusVectorDBStorage

