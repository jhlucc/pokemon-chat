# =============================================
# Pokemon-Chat 环境变量配置
# 使用 Pydantic v2 Settings 自动加载
# =============================================

# ----- LLM 模型 API Keys -----
# 至少配置一个模型提供商的 API Key
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
DEEPSEEK_API_KEY=
ZHIPUAI_API_KEY=
SILICONFLOW_API_KEY=
DASHSCOPE_API_KEY=
TOGETHER_API_KEY=
ARK_API_KEY=

# ----- Reranker & Embedding API Keys -----
JINA_API_KEY=
COHERE_API_KEY=

# ----- Embedding 配置 -----
# 提供商: siliconflow, openai, ollama, dashscope
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# ----- Reranker 配置 -----
# 提供商: siliconflow, dashscope, jina, cohere
RERANKER_ENABLED=true
RERANKER_PROVIDER=siliconflow
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_K=10
RERANKER_THRESHOLD=0.1

# ----- LLM 配置 -----
LLM_PROVIDER=siliconflow
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# ----- Neo4j 图数据库 -----
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# ----- MySQL 数据库 -----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=langgraph

# ----- Milvus 向量数据库 -----
MILVUS_URI=http://localhost:19530

# ----- 功能开关 -----
ENABLE_KNOWLEDGE_BASE=false
ENABLE_KNOWLEDGE_GRAPH=false
ENABLE_WEB_SEARCH=false
ENABLE_MCP=false

# ----- 网络搜索 -----
TAVILY_API_KEY=
